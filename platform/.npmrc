# Mentora platform — pnpm configuration.

# Enterprise dependency hygiene: a package may only import what it declares.
# `hoist=false` + strict peers prevents "phantom dependencies" (using a package
# that happens to be hoisted but is not in package.json) — the single most
# common source of "works on my machine" breakage in large monorepos.
hoist=false
shamefully-hoist=false
strict-peer-dependencies=true

# Reproducibility: CI and local installs must match the committed lockfile.
# `pnpm install --frozen-lockfile` is enforced in CI; this makes the local
# default fail fast on drift as well.
prefer-frozen-lockfile=true

# Determinism & safety.
auto-install-peers=false
resolution-mode=highest
save-exact=true
engine-strict=true

# Lifecycle-script allowlist (pnpm >= 9): dependencies may NOT run postinstall
# scripts unless explicitly listed here. Supply-chain defense by default,
# aligned with the Foundation's F5.4 supply-chain chain of proof.
# (Empty at Lot 0A; entries are added deliberately, with review, in later lots.)
# onlyBuiltDependencies is declared in package.json > pnpm when needed.
