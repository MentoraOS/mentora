{
  "//": "Emit/build project (composite, reference target). Source only.",
  "extends": "@mentora/tsconfig/library",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
