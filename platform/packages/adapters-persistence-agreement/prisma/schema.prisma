// The Agreement registry schema — STRICTLY the Canonical Persistence Model
// (RC-1). The engine is a mechanism (S-1); the EXCLUDE constraint of the R-A
// key and the btree_gist extension live in the hand-authored migration SQL
// (Prisma cannot express EXCLUDE — the migration is the truth of the DDL).
//
// RC-1 verdicts applied:
// - AgreementMigration table: NOT created — the Migration Record (RC-1 §9) IS
//   the mechanism's own bookkeeping (`_prisma_migrations`); a second table
//   would duplicate it (F3.3: one documentary truth, the others reference).
// - AgreementSchemaGeneration table: NOT created — the declared generations
//   are a DERIVED, rebuildable registry (RC-1 §10; S-4/M-5) verified at boot
//   from the code manifests (contracts packages), never a stored truth.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("MENTORA_AGREEMENT_DATABASE_URL")
}

// RC-1 §1/§2 — the PRIVATE photograph (F3.1.11): one row per unit, the
// latest makes faith; version = optimistic guard (F5.2 §4). The expertId /
// slot / stateKind columns are the MATERIALIZED INDEX of the declared R-A
// key and of the declared catalogue walk byExpertAndWindow (RC-1 §1:
// "l'index de tout parcours du catalogue déclaré") — derived from the
// photograph, never a second truth.
model AgreementSnapshot {
  agreementId String @id
  version     Int
  payload     String // VersionedPayload (canonical JSON, formatVersion 1)
  checksum    String // FNV-1a over the payload (corruption => Exception)
  expertId    String
  slotStartMs BigInt
  slotEndMs   BigInt
  stateKind   String

  @@index([expertId, stateKind])
}

// RC-1 §3 — the append-only fact stream: EventIdentity = (agreementId,
// sequence); wire payload of the published language (V-1); no UPDATE, no
// DELETE of facts (S-9). Order is per unit subject only (F4.3 §4).
model AgreementFact {
  agreementId     String
  sequence        Int
  type            String
  payload         String // wire fact, deterministic serialization (1B)
  contractVersion Int
  occurredAtMs    BigInt
  checksum        String

  @@id([agreementId, sequence])
}

// RC-1 §4 — the Outbox de faits: envelope fields + wire fact, born in the
// SAME atomic retention (A-3); read by the Relay executable (A-4/M-4).
// correlationId/causationId are nullable AT WRITE: the frozen port
// retain(unit) cannot transport them — "corrélation portée quand elle
// existe" (F5.3 §2); delivery attempts live HERE, never in a position (P-4).
model AgreementOutbox {
  id               BigInt  @id @default(autoincrement())
  messageId        String  @unique
  agreementId      String
  sequence         Int
  correlationId    String?
  causationId      String?
  deliveryAttempts Int     @default(0)
  payload          String // wire fact (published language)
  occurredAtMs     BigInt
  status           String  @default("pending") // pending | published | quarantined
  claimedUntilMs   BigInt  @default(0)
  nextAttemptAtMs  BigInt  @default(0)
  quarantineReason String?

  @@unique([agreementId, sequence])
  @@index([status, id])
}

// RC-1 §5 — the per-CONSUMER register of processed fact identities (F4.3 §7:
// "chacun son registre"; each consumer OWNS its rows — the shared table is
// physical placement only, a mechanism). Unused today (the reaction table is
// closed and empty — 1C-5/1C-6 STOPs); created because the model is canonical.
model AgreementInbox {
  consumer    String
  agreementId String
  sequence    Int
  processedAtMs BigInt

  @@id([consumer, agreementId, sequence])
}
